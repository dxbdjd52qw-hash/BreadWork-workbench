# ===== 麺包的工作台 · 后端环境变量 =====
# 复制为 .env 后填写真实值：cp .env.example .env
# ⚠️ .env 永远不要提交到 git、不要发给任何人

# DeepSeek API Key（在 https://platform.deepseek.com/ 的 API keys 页面创建）
DEEPSEEK_API_KEY=sk-在这里填你的DeepSeek密钥

# DeepSeek 接口地址与模型（默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 前端「配置接口」里填的共享密钥（自己编一段长随机字符串，前后端要一致）
API_KEY=在这里编一段随机字符串例如-ytwb-9f3k2m8xq7

# JWT 签名密钥（编另一段随机字符串）
JWT_SECRET=再编一段随机字符串-4h8s2n5p1w6e

# 登录账号密码（用于 /api/auth/login 换取 JWT）
ADMIN_USER=admin
ADMIN_PASSWORD=在这里设置一个强密码

# SQLite 数据库文件路径（默认当前目录）
DB_PATH=ytwb.db
